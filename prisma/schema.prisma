generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Distance {
  id             String                @id @default(cuid())
  slug           String                @unique
  name           String
  unit           String // "time" | "laps"
  sortOrder      Int
  records        RecordEntry[]
  historyEntries RecordHistoryEntry[]
  gpEvents       GpEvent[]
  submissions    RecordSubmission[]
}

model RecordEntry {
  id          String    @id @default(cuid())
  distance    Distance  @relation(fields: [distanceId], references: [id])
  distanceId  String
  gender      String // "M" | "F"
  recordType  String // "AGE_GROUP" | "OVERALL"
  ageCategory String  @default("") // "" for OVERALL (Prisma's compound-unique `where` can't take null)
  rank        Int // 1..3
  name        String?
  time        String? // "HH:MM:SS" as given, null for laps-based or empty slot
  laps        Int? // Back Yard Ultra only
  event       String?
  date        DateTime?
  footnote    Footnote? @relation(fields: [footnoteId], references: [id])
  footnoteId  String?

  @@unique([distanceId, gender, recordType, ageCategory, rank])
}

// A record claim sent in via the public /submit form, awaiting review. Kept
// apart from RecordEntry on purpose: nothing here appears on the live
// records pages until an approver (phase 2) acts on it. No login is needed
// to submit, so every field is treated as untrusted user input.
model RecordSubmission {
  id            String    @id @default(cuid())
  distance      Distance  @relation(fields: [distanceId], references: [id])
  distanceId    String
  gender        String // "M" | "F"
  ageCategory   String // one of the bands shown on the records page, e.g. "40-49"
  time          String? // "H:MM:SS" / "MM:SS" as typed; null for laps-based distances
  laps          Int? // Back Yard Ultra only
  athleteName   String
  event         String
  date          DateTime
  email         String
  // Proof of the result: at least one of these is always set (enforced in
  // app/submit/actions.ts, not the DB). photoUrl points at a private Vercel
  // Blob — reading it needs BLOB_READ_WRITE_TOKEN, it isn't a public link.
  // The photo is deleted (and photoUrl cleared) as soon as the submission is
  // approved or declined — see decideSubmission in lib/submissions.ts.
  resultsUrl    String?
  photoUrl      String?
  status        String    @default("PENDING") // "PENDING" | "APPROVED" | "DECLINED"
  submittedAt   DateTime  @default(now())
  decidedAt     DateTime?
  // The records officer's note when declining, for their own reference when
  // contacting the submitter. Null for pending and approved submissions.
  declineReason String?

  @@index([status, submittedAt])
}

// The sheet's "records history" columns only cover 5K/10K/10 Mile/Half
// Marathon/20 Mile/Marathon — other distances simply have no rows here.
// `order` is chronological, ascending (1 = earliest known holder); the
// highest `order` per (distance, gender) is the current record.
model RecordHistoryEntry {
  id         String    @id @default(cuid())
  distance   Distance  @relation(fields: [distanceId], references: [id])
  distanceId String
  gender     String // "M" | "F"
  order      Int
  name       String
  time       String
  event      String?
  date       DateTime?

  @@unique([distanceId, gender, order])
}

model Footnote {
  id      String        @id @default(cuid())
  // Display marker only (e.g. "**") — NOT unique: the sheet reuses the same
  // marker for unrelated footnotes (e.g. "**" means both a Mince Pie 10 and
  // a Beachy Head Ultra distance clarification, disambiguated by context).
  symbol  String
  text    String        @unique
  records RecordEntry[]
}

// ---- Club Grand Prix -----------------------------------------------------

// A runner identity, resolved during CGP import by normalized-name match
// (see lib/runner-match.ts) rather than a fresh row per race tab — results
// for the same person are hand-typed across many tabs, so name strings alone
// would fragment one runner into several. `name` is whatever spelling was
// seen first; later spelling variants of the same normalized name are not
// overwritten.
model Runner {
  id      String     @id @default(cuid())
  name    String
  slug    String     @unique
  // Optional contact address, not used for login — most Runner rows come
  // from GP import and never set this. Handy for pairing a name with an
  // address when sending the welcome email (see scripts/generate-links.ts).
  email          String?    @unique
  // Left the club: excluded from the overall GP leaderboard and news ticker,
  // but their results stay (event pages, Club Pos, their own runner page).
  // Set only via scripts/set-member.ts — the GP import never changes it on
  // an existing runner, and never deletes a former member's results.
  isFormerMember Boolean @default(false)
  results GpResult[]

  c25kProgress      RunnerProgress[]
  badges            RunnerBadge[]
  cohortEnrollments CohortRunner[]
}

model GpEvent {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  date        DateTime
  distance    Distance?  @relation(fields: [distanceId], references: [id])
  distanceId  String?
  scoringType String // "FASTEST_TIME" | "AGE_GRADE" | "NAKED_RUN"
  isSussexGp  Boolean    @default(false)
  sortOrder   Int
  results     GpResult[]
}

model GpResult {
  id            String  @id @default(cuid())
  event         GpEvent @relation(fields: [eventId], references: [id])
  eventId       String
  runner        Runner  @relation(fields: [runnerId], references: [id])
  runnerId      String
  category      String // "M" | "F"
  result        String?
  rawTime       String?
  predictedTime String?
  position      Int?
  points        Int?
  isVolunteer   Boolean @default(false)

  @@unique([eventId, runnerId, category])
}

// ---- Couch to 5K ----------------------------------------------------------

// One run of the C25K programme (e.g. "January 2027"). Weeks/sessions are
// shared plan content (below) — a cohort is just a start date runners
// progress against, so the same 9-week plan can be reused every year.
model Cohort {
  id        String   @id @default(cuid())
  year      Int
  name      String
  startDate DateTime

  progress    RunnerProgress[]
  badges      RunnerBadge[]
  enrollments CohortRunner[]
}

// A runner enrolled in one cohort's run of the programme, and the personal
// long-life link they log in with (see lib/c25k-auth.ts and
// app/c25k/enter/[token]/route.ts). Enrolling someone is currently a manual
// step (add a row via Prisma Studio) — `token` is generated automatically
// the moment the row is created, no need to type one in by hand.
model CohortRunner {
  id       String @id @default(cuid())
  cohort   Cohort @relation(fields: [cohortId], references: [id])
  cohortId String
  runner   Runner @relation(fields: [runnerId], references: [id])
  runnerId String
  token    String @unique @default(cuid())

  createdAt DateTime @default(now())

  @@unique([cohortId, runnerId])
}

// Shared plan content — not cohort-specific, reused every year. There are
// always exactly 9 of these (the standard C25K programme length).
model C25kWeek {
  id          String  @id @default(cuid())
  weekNumber  Int     @unique
  title       String
  description String?

  sessions C25kSession[]
}

model C25kSession {
  id          String   @id @default(cuid())
  week        C25kWeek @relation(fields: [weekId], references: [id])
  weekId      String
  dayLabel    String // e.g. "Day 1"
  description String?
  order       Int

  progress RunnerProgress[]

  @@unique([weekId, order])
}

// One runner ticking off one session within one cohort's run of the
// programme. A runner who repeats the programme in a later cohort gets a
// fresh set of rows rather than reusing the old ones.
model RunnerProgress {
  id          String      @id @default(cuid())
  runner      Runner      @relation(fields: [runnerId], references: [id])
  runnerId    String
  cohort      Cohort      @relation(fields: [cohortId], references: [id])
  cohortId    String
  session     C25kSession @relation(fields: [sessionId], references: [id])
  sessionId   String
  completedAt DateTime    @default(now())

  @@unique([runnerId, cohortId, sessionId])
}

model Badge {
  id          String  @id @default(cuid())
  name        String
  description String?
  criteria    String // free text for now, e.g. "Complete all 9 weeks"

  runners RunnerBadge[]
}

model RunnerBadge {
  id       String   @id @default(cuid())
  runner   Runner   @relation(fields: [runnerId], references: [id])
  runnerId String
  badge    Badge    @relation(fields: [badgeId], references: [id])
  badgeId  String
  cohort   Cohort   @relation(fields: [cohortId], references: [id])
  cohortId String
  earnedAt DateTime @default(now())

  @@unique([runnerId, badgeId, cohortId])
}
