generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Distance {
  id             String                @id @default(cuid())
  slug           String                @unique
  name           String
  unit           String // "time" | "laps"
  sortOrder      Int
  records        RecordEntry[]
  historyEntries RecordHistoryEntry[]
  gpEvents       GpEvent[]
}

model RecordEntry {
  id          String    @id @default(cuid())
  distance    Distance  @relation(fields: [distanceId], references: [id])
  distanceId  String
  gender      String // "M" | "F"
  recordType  String // "AGE_GROUP" | "OVERALL"
  ageCategory String  @default("") // "" for OVERALL (Prisma's compound-unique `where` can't take null)
  rank        Int // 1..3
  name        String?
  time        String? // "HH:MM:SS" as given, null for laps-based or empty slot
  laps        Int? // Back Yard Ultra only
  event       String?
  date        DateTime?
  footnote    Footnote? @relation(fields: [footnoteId], references: [id])
  footnoteId  String?

  @@unique([distanceId, gender, recordType, ageCategory, rank])
}

// The sheet's "records history" columns only cover 5K/10K/10 Mile/Half
// Marathon/20 Mile/Marathon — other distances simply have no rows here.
// `order` is chronological, ascending (1 = earliest known holder); the
// highest `order` per (distance, gender) is the current record.
model RecordHistoryEntry {
  id         String    @id @default(cuid())
  distance   Distance  @relation(fields: [distanceId], references: [id])
  distanceId String
  gender     String // "M" | "F"
  order      Int
  name       String
  time       String
  event      String?
  date       DateTime?

  @@unique([distanceId, gender, order])
}

model Footnote {
  id      String        @id @default(cuid())
  // Display marker only (e.g. "**") — NOT unique: the sheet reuses the same
  // marker for unrelated footnotes (e.g. "**" means both a Mince Pie 10 and
  // a Beachy Head Ultra distance clarification, disambiguated by context).
  symbol  String
  text    String        @unique
  records RecordEntry[]
}

// ---- Club Grand Prix -----------------------------------------------------

// A runner identity, resolved during CGP import by normalized-name match
// (see lib/runner-match.ts) rather than a fresh row per race tab — results
// for the same person are hand-typed across many tabs, so name strings alone
// would fragment one runner into several. `name` is whatever spelling was
// seen first; later spelling variants of the same normalized name are not
// overwritten.
model Runner {
  id      String     @id @default(cuid())
  name    String
  slug    String     @unique
  results GpResult[]
}

model GpEvent {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  date        DateTime
  distance    Distance?  @relation(fields: [distanceId], references: [id])
  distanceId  String?
  scoringType String // "FASTEST_TIME" | "AGE_GRADE" | "NAKED_RUN"
  isSussexGp  Boolean    @default(false)
  sortOrder   Int
  results     GpResult[]
}

model GpResult {
  id            String  @id @default(cuid())
  event         GpEvent @relation(fields: [eventId], references: [id])
  eventId       String
  runner        Runner  @relation(fields: [runnerId], references: [id])
  runnerId      String
  category      String // "M" | "F"
  result        String?
  rawTime       String?
  predictedTime String?
  position      Int?
  points        Int?
  isVolunteer   Boolean @default(false)

  @@unique([eventId, runnerId, category])
}
